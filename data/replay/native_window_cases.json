        "app": "TextEdit",
        "window_ref": "window-a",
        "title": "Onboarding checklist",
        "document_id": "shared-doc",
        "case_ref": "case-b"
      }
    ],
    "expected_groups": [
      [
        "a"
      ],
      [
        "b"
      ]
    ],
    "note": "Different explicit cases remain separate even in one window/document."
  },
