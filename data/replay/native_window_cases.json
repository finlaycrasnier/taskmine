  {
    "name": "different_terminal_windows",
    "steps": [
      {
        "op": "observe",
        "id": "g1",
        "at_seconds": 0,
        "app": "Ghostty",
        "window_ref": "terminal-a",
        "title": "Onboarding checklist"
      },
      {
        "op": "observe",
        "id": "g2",
        "at_seconds": 1,
        "app": "Ghostty",
        "window_ref": "terminal-b",
        "title": "Onboarding checklist"
      },
      {
        "op": "observe",
        "id": "g3",
        "at_seconds": 2,
        "app": "Ghostty",
        "window_ref": "terminal-a",
        "title": "Onboarding checklist"
      }
    ],
    "expected_groups": [
      [
        "g1",
        "g3"
      ],
      [
        "g2"
      ]
    ],
    "note": "Same app/title and short time do not merge distinct windows. Return to a recent known window may resume its provisional group."
  },
  {
    "name": "finder_textedit_shared_document",
    "steps": [
      {
        "op": "observe",
        "id": "f",
        "at_seconds": 0,
        "app": "Finder",
        "window_ref": "finder-window",
        "title": "Documents",
        "document_id": "opaque-doc-a"
      },
      {
        "op": "observe",
        "id": "t",
        "at_seconds": 3,
        "app": "TextEdit",
        "window_ref": "window-a",
        "title": "Onboarding checklist",
        "document_id": "opaque-doc-a"
      }
    ],
    "expected_groups": [
      [
        "f",
        "t"
      ]
    ],
    "note": "Finder must reference the same selected document. Merely viewing its folder is not evidence of the same document."
  },
  {
    "name": "finder_textedit_no_relationship",
    "steps": [
      {
        "op": "observe",
        "id": "f",
        "at_seconds": 0,
        "app": "Finder",
        "window_ref": "finder-window",
        "title": "Documents"
      },
      {
        "op": "observe",
        "id": "t",
        "at_seconds": 3,
        "app": "TextEdit",
        "window_ref": "window-a",
        "title": "Onboarding checklist"
      }
    ],
    "expected_groups": [
      [
        "f"
      ],
      [
        "t"
      ]
    ],
    "note": "May suggest connection or show adjacent segments. Do not silently claim one case without a shared signal or employee correction."
  },
  {
    "name": "terminal_interruption",
    "steps": [
      {
        "op": "observe",
        "id": "f",
        "at_seconds": 0,
        "app": "Finder",
        "window_ref": "finder-window",
        "title": "Onboarding checklist",
        "document_id": "opaque-doc-a"
      },
      {
        "op": "observe",
        "id": "g",
        "at_seconds": 2,
        "app": "Ghostty",
        "window_ref": "terminal-a",
        "title": "Unrelated build"
      },
      {
        "op": "observe",
        "id": "t",
        "at_seconds": 5,
        "app": "TextEdit",
        "window_ref": "window-a",
        "title": "Onboarding checklist",
        "document_id": "opaque-doc-a"
      }
    ],
    "expected_groups": [
      [
        "f",
        "t"
      ],
      [
        "g"
      ]
    ],
    "note": "Cross-app document continuation must not absorb the intervening terminal action."
  },
  {
