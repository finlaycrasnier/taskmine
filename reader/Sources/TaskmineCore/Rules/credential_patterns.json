{
 "_comment": "Transcribed from desktop/collector/Sources/DesktopCollectorCore/DiscoveryTextSafety.swift (sanitizer_version 2) and cross-checked against services/observation/credential_safety.py. Syntax is ICU (NSRegularExpression). Flags are inline. Replacement text is the literal [redacted].",
 "sanitizer_version": 2,
 "redacted": "[redacted]",
 "limits": {
  "max_input_scalars": 1000000,
  "max_url_scalars": 2048,
  "max_decode_rounds": 2,
  "max_decoded_tokens": 200,
  "max_split_value_scalars": 512,
  "generic_min_length": 32,
  "generic_min_digits": 2,
  "generic_min_upper": 2,
  "generic_min_lower": 2
 },
 "normalize": {
  "invisible_class": "[\\u00ad\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u206a-\\u206f\\ufeff]",
  "space_class": "[\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000]",
  "line_break_class": "\\r\\n|[\\r\\u000b\\u000c\\u0085\\u2028\\u2029]",
  "unicode_form": "NFKC",
  "order": [
   "truncate to max_input_scalars",
   "NFKC",
   "delete invisible",
   "space_class to U+0020",
   "line_break_class to \\n"
  ]
 },
 "exclusion_patterns": {
  "recorder_files": "(?i)(?<![a-z0-9_.-])(?:browser-key\\.txt|review-key\\.txt|launch-url\\.txt|collector-connection\\.json|teams-connection\\.json|call-worker-connection\\.json)(?![a-z0-9_.-])",
  "secret_files": "(?i)(?:^|[/\\\\\\s\"'`(\\[])(?:\\.env(?!\\.(?:example|sample|template|dist)(?:$|[/\\\\\\s\"'`:)\\],]))(?:\\.[a-z0-9_-]+)*|config\\.env|\\.npmrc|\\.pypirc|\\.netrc|\\.pgpass|\\.git-credentials|\\.htpasswd|credentials\\.(?:json|csv)|id_(?:rsa|dsa|ed25519|ecdsa)|[^/\\\\\\s\"'`(\\[]+\\.(?:pem|p12|pfx|key|keystore|jks|ppk|kdbx))(?:$|[/\\\\\\s\"'`:)\\],])",
  "path_credentials": "(?i)[/\\\\]credentials(?:$|[/\\\\\\s\"'`:)\\],])",
  "title_credentials_titles_only": "(?i)^\\s*credentials(?:\\s*$|\\s+[-|:–—])",
  "private_key": "(?i)-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----|PuTTY-User-Key-File-\\d",
  "private_key_block": "(?is)-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----.*?(?:-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----|\\z)"
 },
 "exclusion_reasons": {
  "private_key": "private_key",
  "credential_document": "credential_document",
  "oversize_or_unparseable": "credential_pattern",
  "unterminated_quote_or_password_label": "password_label"
 },
 "redaction_patterns": {
  "userinfo": "(?i)\\b([a-z][a-z0-9+.-]*://)([^\\s/@?#\\[\\]]+)@",
  "query_secret": "(?i)([?&;](?:[a-z0-9]+[_.-])*(?:token|secret|password|passwd|pwd|pass|apikey|api_key|key|auth|authorization|signature|sig|session|sessionid|sid|code|credential|credentials|jwt)=)[^&#\\s\"'<>]+",
  "bearer": "(?i)\\b(bearer[ \\t]+)([A-Za-z0-9._~+/=-]{8,})",
  "provider_tokens": "(?<![A-Za-z0-9_-])(?:sk-[A-Za-z0-9_-]{16,}|(?:sk|rk|pk)_(?:live|test)_[A-Za-z0-9]{16,}|re_(?=[A-Za-z0-9_]*[0-9])(?=[A-Za-z0-9_]*[A-Z])[A-Za-z0-9_]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[abposr]-[A-Za-z0-9-]{10,}|xapp-[0-9]-[A-Za-z0-9-]{10,}|(?:AKIA|ASIA)[A-Z0-9]{16}|AIza[A-Za-z0-9_-]{30,}|ya29\\.[A-Za-z0-9_-]{20,}|glpat-[A-Za-z0-9_-]{20,}|npm_[A-Za-z0-9]{30,}|hf_[A-Za-z0-9]{30,}|phx_[A-Za-z0-9_]{20,}|SG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}|shp(?:at|ss|ca|pa)_[A-Fa-f0-9]{32}|eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})(?![A-Za-z0-9_-])",
  "label_core": "password|passwd|passphrase|pwd|secret|token|api[_ -]?key|apikey|private[_ -]?key|access[_ -]?key|secret[_ -]?key|credentials?|authorization|account[_ -]?key|shared[_ -]?access[_ -]?key|recovery[_ -]?codes?",
  "label": "(?<![A-Za-z0-9])[A-Za-z0-9_.-]*?(?:password|passwd|passphrase|pwd|secret|token|api[_ -]?key|apikey|private[_ -]?key|access[_ -]?key|secret[_ -]?key|credentials?|authorization|account[_ -]?key|shared[_ -]?access[_ -]?key|recovery[_ -]?codes?)(?![A-Za-z0-9_])",
  "header_label_assignment": "(?i)(?:(?<![A-Za-z0-9])[A-Za-z0-9_.-]*?(?:password|passwd|passphrase|pwd|secret|token|api[_ -]?key|apikey|private[_ -]?key|access[_ -]?key|secret[_ -]?key|credentials?|authorization|account[_ -]?key|shared[_ -]?access[_ -]?key|recovery[_ -]?codes?)(?![A-Za-z0-9_])(?:\\\\?[\"'])?(?:[ \\t]*(:=|=>|=(?!=)|:)[ \\t]*|[ \\t]+(?:is|was)[ \\t]+)|(?<!\\S)--?(?:[A-Za-z0-9]+[_-])*(?:password|passwd|passphrase|pwd|secret|token|api[_ -]?key|apikey|private[_ -]?key|access[_ -]?key|secret[_ -]?key|credentials?|authorization|account[_ -]?key|shared[_ -]?access[_ -]?key|recovery[_ -]?codes?)(?![A-Za-z0-9_])[ \\t]+(?!-))",
  "field_boundary": "(?:[,;&][ \\t]*(?=[\"']?[A-Za-z_][A-Za-z0-9_.-]*[\"']?[ \\t]*(?::=|=>|=(?!=)|:))|[ \\t]+(?=--?[A-Za-z][A-Za-z0-9_-]*[ \\t=]))",
  "code_value_not_a_secret": "(?i)^(?:(?:str|string|bytes|int|bool|boolean|number|any|none|null|nil|undefined|true|false|await|new|this|self|secretstr|optional)|os\\.environ\\[(?:\"[A-Za-z_][A-Za-z0-9_]*\"|'[A-Za-z_][A-Za-z0-9_]*')\\])(?:[ \\t]*[,;})]|[ \\t]*\\)[ \\t]*->[ \\t]*[A-Za-z_][A-Za-z0-9_.\\[\\]]*[ \\t]*:)?$",
  "label_only_line": "(?i)^[ \\t]*(?:password|passwd|passphrase|pwd|secret|token|api[_ -]?key|apikey|private[_ -]?key|access[_ -]?key|secret[_ -]?key|credentials?|authorization|account[_ -]?key|shared[_ -]?access[_ -]?key|recovery[_ -]?codes?|pin)[ \\t]*:?[ \\t]*$",
  "generic_long_token": "(?<![A-Za-z0-9_+=-])[A-Za-z0-9_+=-]{32,}(?![A-Za-z0-9_+=-])",
  "percent_encoded_token": "(?<!\\S)\\S*%[0-9A-Fa-f]{2}\\S*",
  "percent_run": "(?:%[0-9A-Fa-f]{2})+"
 },
 "password_manager_hosts_for_urls": [
  "1password.com",
  "1password.eu",
  "1password.ca",
  "bitwarden.com",
  "bitwarden.eu",
  "lastpass.com",
  "dashlane.com",
  "keepersecurity.com",
  "keepersecurity.eu",
  "pass.proton.me",
  "passwords.google.com",
  "nordpass.com",
  "roboform.com",
  "keeper.io"
 ],
 "scan_order": [
  "if decode: percent-encoded token decodes to a private key -> whole value becomes [redacted] reason private_key",
  "(detection mode only) replace private key blocks",
  "percent-encoded tokens (at most 200, each at most 2048 scalars): redact the token if its decode still holds a percent run or its decoded form hits any other redaction pattern",
  "userinfo: redact when it holds ':' or '%3a' or is 20 scalars or longer",
  "query_secret",
  "bearer: skip when the token is only ASCII letters",
  "provider_tokens",
  "label_core assignments (header): redact value to end of line, or to the next label/field boundary; quoted value keeps its quotes; unterminated quote excludes the record (password_label); skip empty, already [redacted], or a code-like value when no quote and the label matched a group",
  "label-only line: redact the next non-empty line within 2 lines (up to 512 scalars, not itself a label line)",
  "generic_long_token: redact only when the token has at least 2 digits, 2 upper-case and 2 lower-case ASCII letters"
 ],
 "applies_to": {
  "text": "evaluate(value) on screen text, OCR text, field values",
  "title": "evaluate(value,title=true) on window_title and every focus label; adds title_credentials",
  "url": "sanitizeURL on document_url: keeps scheme, host, port and path; drops the query and fragment; returns null for password-manager hosts, any path that hits an exclusion or redaction pattern, a percent run in the path, or an address over 2048 scalars",
  "metadata": "window_title uses title rules, document_url uses url rules, every other value uses text rules; any null excludes the whole record"
 }
}