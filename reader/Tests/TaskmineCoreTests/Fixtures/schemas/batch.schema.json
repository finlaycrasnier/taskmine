{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskmine.local/contracts/batch.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "taskmine.batch/1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "event.schema.json"
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schema",
    "batch_id",
    "source_id",
    "events"
  ],
  "additionalProperties": false
}